# DebtFlow production — chép thành .env cạnh docker-compose.prod.yml rồi điền giá trị thật.

# ---- Database ----
POSTGRES_USER=debtflow
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH_NAY
POSTGRES_DB=debtflow

# ---- Auth (sinh bằng: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=DOI_SECRET_NAY
JWT_REFRESH_SECRET=DOI_SECRET_KHAC_NAY
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Web ----
# Origin FE (khớp domain thật, dùng cho CORS).
CORS_ORIGIN=https://debtflow.example.com
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- Backup (tự động mỗi ngày lúc BACKUP_AT theo giờ VN) ----
TZ=Asia/Ho_Chi_Minh
BACKUP_AT=23:00
BACKUP_KEEP=14

# ---- Đẩy backup lên Google Drive (offsite — đề phòng VPS chết) ----
# Trống = tắt. Bật: cấu hình deploy/rclone.conf (rclone config) rồi đặt remote:thư-mục.
RCLONE_REMOTE=
# Đã trỏ sẵn deploy/rclone.conf vào thư mục Drive của bạn (root_folder_id).
# Bật bằng:  RCLONE_REMOTE=gdrive:
RCLONE_KEEP_DAYS=30

# ---- Rollback: đặt tag image cũ rồi `up -d` (mặc định latest) ----
IMAGE_TAG=latest

# ---- Seed admin đầu tiên (docker compose exec api npx prisma db seed) ----
SEED_ADMIN_EMAIL=admin@debtflow.local
SEED_ADMIN_PASSWORD=DOI_MAT_KHAU_ADMIN
